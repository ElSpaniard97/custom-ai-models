{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lone-star-private-ai",
  "main": "worker.js",
  "compatibility_date": "2026-06-23",
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
